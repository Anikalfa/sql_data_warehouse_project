                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[UPPER]([TRIM](#{Package\Load Silver PrdInfo\bronze crm_prd_info.Outputs[OLE DB Source Output].Columns[prd_line]})) == "M" ? "Mountain" : ([UPPER]([TRIM](#{Package\Load Silver PrdInfo\bronze crm_prd_info.Outputs[OLE DB Source Output].Columns[prd_line]})) == "R" ? "Road" : ([UPPER]([TRIM](#{Package\Load Silver PrdInfo\bronze crm_prd_info.Outputs[OLE DB Source Output].Columns[prd_line]})) == "S" ? "Other Sales" : ([UPPER]([TRIM](#{Package\Load Silver PrdInfo\bronze crm_prd_info.Outputs[OLE DB Source Output].Columns[prd_line]})) == "T" ? "Touring" : "n/a")))</property>
