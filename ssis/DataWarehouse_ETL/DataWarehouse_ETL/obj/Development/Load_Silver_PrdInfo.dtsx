                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">UPPER(TRIM(prd_line)) == "M" ? "Mountain" : (UPPER(TRIM(prd_line)) == "R" ? "Road" : (UPPER(TRIM(prd_line)) == "S" ? "Other Sales" : (UPPER(TRIM(prd_line)) == "T" ? "Touring" : "n/a")))</property>
