              description="OLE DB Source"
              name="bronze crm_sales_details"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    sls_ord_num,
    sls_prd_key,
    TRY_CAST(sls_cust_id AS INT) AS sls_cust_id,

    CASE 
        WHEN TRY_CAST(sls_order_dt AS INT) = 0 OR LEN(TRY_CAST(sls_order_dt AS VARCHAR)) != 8 THEN NULL
        ELSE TRY_CAST(CAST(TRY_CAST(sls_order_dt AS INT) AS VARCHAR) AS DATE)
    END AS sls_order_dt,

    CASE 
        WHEN TRY_CAST(sls_ship_dt AS INT) = 0 OR LEN(TRY_CAST(sls_ship_dt AS VARCHAR)) != 8 THEN NULL
        ELSE TRY_CAST(CAST(TRY_CAST(sls_ship_dt AS INT) AS VARCHAR) AS DATE)
    END AS sls_ship_dt,

    CASE 
        WHEN TRY_CAST(sls_due_dt AS INT) = 0 OR LEN(TRY_CAST(sls_due_dt AS VARCHAR)) != 8 THEN NULL
        ELSE TRY_CAST(CAST(TRY_CAST(sls_due_dt AS INT) AS VARCHAR) AS DATE)
    END AS sls_due_dt,

    TRY_CAST(sls_sales AS INT) AS sls_sales_raw,
    TRY_CAST(sls_quantity AS INT) AS sls_quantity,
    TRY_CAST(sls_price AS INT) AS sls_price_raw

FROM bronze.crm_sales_details
WHERE sls_ord_num IS NOT NULL;</property>
                <property
