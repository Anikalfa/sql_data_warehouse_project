                    <outputColumn
                      refId="Package\Load Silver CustAz12\Derive gender.Outputs[Derived Column Output].Columns[gen_clean]"
                      dataType="wstr"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      length="6"
                      lineageId="Package\Load Silver CustAz12\Derive gender.Outputs[Derived Column Output].Columns[gen_clean]"
                      name="gen_clean"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[UPPER]([TRIM](#{Package\Load Silver CustAz12\bronze erp_cust_az12.Outputs[OLE DB Source Output].Columns[gen_raw]})) == "F" || [UPPER]([TRIM](#{Package\Load Silver CustAz12\bronze erp_cust_az12.Outputs[OLE DB Source Output].Columns[gen_raw]})) == "FEMALE" ? "Female" : ([UPPER]([TRIM](#{Package\Load Silver CustAz12\bronze erp_cust_az12.Outputs[OLE DB Source Output].Columns[gen_raw]})) == "M" || [UPPER]([TRIM](#{Package\Load Silver CustAz12\bronze erp_cust_az12.Outputs[OLE DB Source Output].Columns[gen_raw]})) == "MALE" ? "Male" : "n/a")</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">UPPER(TRIM(gen_raw)) == "F" || UPPER(TRIM(gen_raw)) == "FEMALE" ? "Female" : (UPPER(TRIM(gen_raw)) == "M" || UPPER(TRIM(gen_raw)) == "MALE" ? "Male" : "n/a")</property>
                      </properties>
                    </outputColumn>
                  </outputColumns>
                  <externalMetadataColumns />
